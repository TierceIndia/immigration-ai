# PostgreSQL — TEST database (isolated from dev/production)
DATABASE_URL=postgresql://immigration:immigration_dev@localhost:5432/immigration_test
POSTGRES_DB=immigration_test
POSTGRES_USER=immigration
POSTGRES_PASSWORD=immigration_dev

# Application
SECRET_KEY=changeme-generate-a-real-secret
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Budget
LLM_DAILY_BUDGET_USD=10.00
LLM_MONTHLY_BUDGET_USD=100.00
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=120

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scheduler
ENABLE_SCHEDULER="false"
GOVERNMENT_SYNC_INTERVAL_MINUTES="60"

# Auth
JWT_SECRET_KEY=test-secret-key-do-not-use-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Testing flag (also set by conftest.py)
TESTING=true
