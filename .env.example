# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/immigration
POSTGRES_DB=immigration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# LLM Providers
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Application
SECRET_KEY=changeme-generate-a-real-secret
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Budget
LLM_DAILY_BUDGET_USD=10.00
LLM_MONTHLY_BUDGET_USD=100.00
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=120

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Auth
JWT_SECRET_KEY=changeme-generate-a-real-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
