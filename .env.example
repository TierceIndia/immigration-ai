# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/immigration
POSTGRES_DB=immigration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Registry seeding (python src/seed_registry.py)
# The CLI seeds the DATABASE_URL backend (PostgreSQL) and fails loudly when
# DATABASE_URL is missing. Set SEED_BACKEND=sqlite ONLY to force the legacy
# SQLite seed mode used by the standalone offline pipeline scripts.

# LLM Provider (OpenAI only — production extraction refuses every other provider)
# Required for real requirement extraction. There is NO silent fallback to a
# mock: if this key is missing the pipeline fails fast rather than fabricate.
OPENAI_API_KEY=sk-your-key-here

# LLM requirement extraction model used by the fetch -> store -> extract path.
# Defaults to gpt-4o-mini when unset. Only OpenAI model names are accepted
# (examples: gpt-4o-mini, gpt-4o, ft:gpt-4o-mini-...). mock-llm-v1 / gemini-* /
# claude-* are rejected by the production factory.
EXTRACTION_MODEL=gpt-4o-mini

# LLM Budget
# Low safe suggested cap for everyday use; the code falls back to 10.0 USD/day
# (200.0 USD/month) when these are left unset.
LLM_DAILY_BUDGET_USD=2.00
LLM_MONTHLY_BUDGET_USD=50.00
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=120

# Application
SECRET_KEY=changeme-generate-a-real-secret
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scheduler
ENABLE_SCHEDULER="true"
GOVERNMENT_SYNC_INTERVAL_MINUTES="60"

# Fetch politeness & egress (source retrieval)
# Minimum spacing between two requests to the *same* host, plus additive jitter
# so the pattern is not metronomic. This is ordinary client-side etiquette, not
# evasion: it changes *when* we ask, never how we identify ourselves. Defaults:
# 8s minimum interval + up to 4s random jitter. A malformed value falls back to
# the (more polite) default rather than becoming a faster crawl.
FETCH_MIN_INTERVAL_SECONDS=8
FETCH_JITTER_SECONDS=4
# After a host answers a refusal (HTTP 403/429), pause *every* source on that
# host for this many hours before trying again. Timeouts, DNS failures and 5xx
# are faults, not refusals, and never pause anything. Set to 0 (or negative) to
# disable the pause. Default: 6.
FETCH_COOLDOWN_HOURS=6
# Optional single STATIC egress proxy for reachability/egress control, e.g.
#   http://user:pass@proxy.internal:3128   (http/https only - no SOCKS support)
# Leave blank (default) to connect directly. This is ONE fixed value — it is
# never rotated and never changes in response to a refusal. A malformed value
# FAILS CLOSED: affected fetches are refused and reported, never silently sent
# direct. Any credentials are redacted from logs and error strings.
FETCH_PROXY_URL=

# Auth
JWT_SECRET_KEY=changeme-generate-a-real-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Admin bootstrap (idempotent, optional)
# On startup, if BOTH ADMIN_EMAIL and ADMIN_PASSWORD are set, the app creates (or
# promotes) that admin user. When either is left blank, no admin is auto-created
# and you must use: python src/create_admin.py --email ADMIN@x --password '...'
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator