# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/immigration
POSTGRES_DB=immigration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Registry seeding (python src/seed_registry.py)
# The CLI seeds the DATABASE_URL backend (PostgreSQL) and fails loudly when
# DATABASE_URL is missing. Set SEED_BACKEND=sqlite ONLY to force the legacy
# SQLite seed mode used by the standalone offline pipeline scripts.

# LLM Providers
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM requirement extraction model used by the fetch -> store -> extract path.
# Blank/unset keeps the deterministic offline mock-llm-v1 (no API key, no network).
# Set a real provider model to enable live extraction, e.g.:
#   EXTRACTION_MODEL=gemini-flash-lite-latest
#   EXTRACTION_MODEL=gpt-4o-mini
#   EXTRACTION_MODEL=claude-sonnet-4-6
EXTRACTION_MODEL=

# LLM Budget
# Low safe suggested cap for everyday use; the code falls back to 10.0 USD/day
# (200.0 USD/month) when these are left unset.
LLM_DAILY_BUDGET_USD=2.00
LLM_MONTHLY_BUDGET_USD=50.00
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=120

# Application
SECRET_KEY=changeme-generate-a-real-secret
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scheduler
ENABLE_SCHEDULER="true"
GOVERNMENT_SYNC_INTERVAL_MINUTES="60"

# Auth
JWT_SECRET_KEY=changeme-generate-a-real-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Admin bootstrap (idempotent, optional)
# On startup, if BOTH ADMIN_EMAIL and ADMIN_PASSWORD are set, the app creates (or
# promotes) that admin user. When either is left blank, no admin is auto-created
# and you must use: python src/create_admin.py --email ADMIN@x --password '...'
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
